# Copy this file to .env and fill in real values before deploying.

# Port the server listens on.
PORT=3000

# Secret key for the admin moderation endpoints (GET/POST /api/admin/*).
# Choose a long random string. Without this set, the admin panel is disabled.
ADMIN_KEY=change-me-to-something-long-and-random

# Secret used to sign login session cookies. Choose a long random string.
# Without this set, a random one is generated at boot — fine for trying
# things out, but it means everyone gets logged out on every restart.
SESSION_SECRET=b6d043f6226f21b229ffc00703e8d5374afe2b33332e8d739d5522923cdc4ac5

# --- Google sign-in ---------------------------------------------------
# From https://console.cloud.google.com/apis/credentials — create an
# "OAuth client ID" of type "Web application". Add the callback URL below
# to "Authorized redirect URIs" in that same screen.
GOOGLE_CLIENT_ID=<1089544043119-kisabueb94mfunqtec3hvoghfl7pld1u.apps.googleusercontent.com>
GOOGLE_CLIENT_SECRET=<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>
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback


# --- Instagram sign-in --------------------------------------------------
# From https://developers.facebook.com/apps — create an app, add the
# "Instagram" product, and use its API setup screen to get these values.
# Add the callback URL below under that product's valid OAuth redirect URIs.
# IMPORTANT: until Meta approves your app for public use, sign-in only
# works for Instagram accounts you've explicitly added as "Instagram
# testers" in the same dashboard. See the README for details.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_CALLBACK_URL=http://localhost:3000/auth/instagram/callback
