[TEMPLATE]
# Copy this file to .env and fill in real values before deploying.

# Port the server listens on.
PORT=3000

# Secret key for the admin moderation endpoints (GET/POST /api/admin/*).
# Choose a long random string. Without this set, the admin panel is disabled.
ADMIN_KEY=change-me-to-something-long-and-random

# Secret used to sign login session cookies. Choose a long random string.
# Without this set, a random one is generated at boot — fine for trying
# things out, but it means everyone gets logged out on every restart.
SESSION_SECRET=b6d043f6226f21b229ffc00703e8d5374afe2b33332e8d739d5522923cdc4ac5

# --- Google sign-in ---------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# --- Instagram sign-in --------------------------------------------------
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_CALLBACK_URL=http://localhost:3000/auth/instagram/callback

# --- Email / Resend (for password recovery OTPs) ------------------------
# Free tier: 100 emails/day — https://resend.com
#
# 1. Sign up at https://resend.com (free)
# 2. Go to https://resend.com/api-keys → Create API Key
# 3. Copy the key into RESEND_API_KEY below
# 4. For production: add & verify your own domain at https://resend.com/domains
#    then set RESEND_FROM to something like "Bookove <noreply@yourdomain.com>"
#    For testing: leave RESEND_FROM blank to use the default resend.dev sender
#
RESEND_API_KEY=
RESEND_FROM=
SITE_NAME=Bookove

# --- Persistent database (Turso) -------------------------------------------
# Required in production (Vercel): without these the app falls back to an
# ephemeral /tmp database that is wiped on every deploy and cold start.
#
# 1. Sign up at https://turso.tech (free) and install the CLI:
#    curl -fsSL https://get.tur.so/install.sh | bash && turso auth login
# 2. Create a database:  turso db create bookove
# 3. Get the URL:        turso db show bookove --url
# 4. Get a token:        turso db tokens create bookove
# 5. Set both as environment variables in Vercel (Settings → Environment
#    Variables), then redeploy.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Persistent file storage (Vercel Blob) ---------------------------------
# Required in production: uploaded book files and avatars live here instead
# of the ephemeral function disk.
#
# In the Vercel dashboard: Storage → Create Blob Store → connect it to this
# project. Vercel then injects BLOB_READ_WRITE_TOKEN automatically.
BLOB_READ_WRITE_TOKEN=
